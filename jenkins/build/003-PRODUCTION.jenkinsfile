pipeline {
    agent any

    environment {
        BRANCH = '003-PRODUCTION'
        BASE_DIR = '/home/projects'
        PROFILE_EXTRACTION = "dataset-IA"
        REPO_PROFILE_EXTRACTION = "git@github.com:cimacorporate/dataset-IA.git"
        PROJECT_DIR_RENAMED = "${BASE_DIR}/${PROFILE_EXTRACTION}"
        COMPOSE_FILE_WORKER="docker-compose.worker.yaml"
        COMPOSE_FILE="docker-compose.yml"

    }

    stages {
        stage('Fix SSH permissions') {
            steps {
                sh '''
                  chown -R root:root /root/.ssh
                  chmod 700 /root/.ssh
                  chmod 600 /root/.ssh/id_rsa
                  chmod 644 /root/.ssh/id_rsa.pub
                  ssh-keyscan github.com >> /root/.ssh/known_hosts
                '''
            }
        }


         // Clone repo if needed
        stage("clone repositories") {
            steps {
                script {
                    if (!fileExists("${env.PROJECT_DIR_RENAMED}")) {
                        echo "Cloning '${env.PROFILE_EXTRACTION}'..."
                        sh "git clone ${env.REPO_PROFILE_EXTRACTION} ${env.PROJECT_DIR_RENAMED}"
                    }
                    else {
                        echo "Repo '${env.PROFILE_EXTRACTION}' already exists. Continuing..."
                    }
                }
            }
        }

        // Protect folder
        stage("configure Git") {
            steps {
                dir("${env.BASE_DIR}") {
                    sh "git config --global --add safe.directory ${env.PROJECT_DIR_RENAMED}"
                }
            }
        }

        stage('Global set folders') {
            steps {
                dir("${env.PROJECT_DIR_RENAMED}") {
                    sh "git config --global --add safe.directory ${env.PROJECT_DIR_RENAMED}"
                }
            }
        }

       // Set branch
        stage("change branch") {
            steps {
                dir("${env.PROJECT_DIR_RENAMED}") {
                        sh "git switch ${env.BRANCH}"
                }
            }
        }
        
       stage('Build image with Docker Compose ') {
            steps {
                dir("${PROJECT_DIR_RENAMED}") {
                    sh """
                    if docker network inspect dataset-IA-net >/dev/null 2>&1; then
                        echo "Network dataset-IA-net already exists."
                    else
                        docker network create --driver bridge --attachable dataset-IA-net
                    fi

                    echo ">>> Building images with docker-compose..."
                    docker compose -f ${COMPOSE_FILE} build
                    docker compose -f ${COMPOSE_FILE_WORKER} build
                    """
                }
            }
        }
    }
}